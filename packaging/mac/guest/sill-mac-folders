#!/bin/sh
# The person's Mac folders at their Mac paths inside the VM (docs/sill-stick.md section 9).
# sill-gui gives each folder a share slot of its own (virtiofs tag sill-mac-SLOT) and runs this as
# root with lines of SLOT<TAB>PATH on stdin; each slot is mounted at its folder's Mac path, so the
# VM, its jails and the person see one path. Only folders of a Mac user (/Users/…) or on a Mac
# volume (/Volumes/…): nothing of the guest's own can be covered. A mount left stale (its slot
# given another folder) is replaced. sill-gui sends this script with each use.
set -eu
tab=$(printf '\t')
status=0
while IFS="$tab" read -r slot path; do
    case "$slot" in '' | *[!0-9]*) echo "sill-mac-folders: bad slot: $slot" >&2; status=1; continue ;; esac
    case "$path" in
        /Users/?* | /Volumes/?*) ;;
        *) echo "sill-mac-folders: not a Mac user's folder: $path" >&2; status=1; continue ;;
    esac
    case "/$path/" in */../* | */./*) echo "sill-mac-folders: not a plain path: $path" >&2; status=1; continue ;; esac
    tag="sill-mac-$slot"
    if findmnt -n --mountpoint "$path" >/dev/null 2>&1; then
        if stat "$path" >/dev/null 2>&1 && [ "$(findmnt -n -o SOURCE --mountpoint "$path")" = "$tag" ]; then
            continue
        fi
        umount -l "$path" || true
    fi
    mkdir -p "$path"
    mount -t virtiofs "$tag" "$path" || { echo "sill-mac-folders: cannot mount $path" >&2; status=1; }
done
exit $status
