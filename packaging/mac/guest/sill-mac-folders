#!/bin/sh
# The person's Mac folders at their Mac paths inside the VM (docs/sill-stick.md section 9).
# sill-gui gives each folder a share slot of its own (virtiofs tag sill-mac-SLOT) and runs this as
# root with lines of SLOT<TAB>PATH on stdin; each slot is mounted at its folder's Mac path, so the
# VM, its jails and the person see one path. Only folders of a Mac user (/Users/…) or on a Mac
# volume (/Volumes/…): nothing of the guest's own can be covered. A mount left stale (its slot
# given another folder) is replaced. Asked to `unmount`, it takes paths on stdin, one a line, and
# unmounts those that are mounted.
#
# This is the one thing Sill.app does as root in its VM, and the VM's account has no sudo
# (docs/sill-mac.md, finding 15): the image installs this root-owned, and root's SSH lets
# Sill.app's key in for this command only, whatever it asks for (the request is in
# SSH_ORIGINAL_COMMAND). So nothing here trusts its input further than the checks below.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
tab=$(printf '\t')
status=0
mac_path() {
    case "$1" in
        /Users/?* | /Volumes/?*) ;;
        *) echo "sill-mac-folders: not a Mac user's folder: $1" >&2; return 1 ;;
    esac
    case "/$1/" in */../* | */./*) echo "sill-mac-folders: not a plain path: $1" >&2; return 1 ;; esac
}
case "${SSH_ORIGINAL_COMMAND:-${1:-mount}}" in
    mount) ;;
    unmount)
        while IFS= read -r path; do
            mac_path "$path" || { status=1; continue; }
            if findmnt -n --mountpoint "$path" >/dev/null 2>&1; then
                umount -l -- "$path" || { echo "sill-mac-folders: cannot unmount $path" >&2; status=1; }
            fi
        done
        exit $status
        ;;
    *) echo 'sill-mac-folders: mount or unmount' >&2; exit 2 ;;
esac
while IFS="$tab" read -r slot path; do
    case "$slot" in '' | *[!0-9]*) echo "sill-mac-folders: bad slot: $slot" >&2; status=1; continue ;; esac
    mac_path "$path" || { status=1; continue; }
    tag="sill-mac-$slot"
    if findmnt -n --mountpoint "$path" >/dev/null 2>&1; then
        if stat "$path" >/dev/null 2>&1 && [ "$(findmnt -n -o SOURCE --mountpoint "$path")" = "$tag" ]; then
            continue
        fi
        umount -l "$path" || true
    fi
    # through no link: a share already mounted is the VM account's to write, and a link in it
    # would put this mount over a folder of the guest's own
    if [ "$(realpath -m -- "$path" 2>/dev/null)" != "$path" ]; then
        echo "sill-mac-folders: a link is in the way of $path" >&2; status=1; continue
    fi
    mkdir -p "$path"
    mount -t virtiofs "$tag" "$path" || { echo "sill-mac-folders: cannot mount $path" >&2; status=1; }
done
exit $status
