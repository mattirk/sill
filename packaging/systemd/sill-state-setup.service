# sill state filesystem (SPEC §4.9): session upper trees must live on a filesystem that is not inside
# any overlaid tree. This creates a sparse ext4 image on first boot; var-lib-sill.mount mounts it.
# Grow later with: systemctl stop var-lib-sill.mount; truncate -s 64G /var/lib/sill.img;
#                  e2fsck -f /var/lib/sill.img; resize2fs /var/lib/sill.img; systemctl start var-lib-sill.mount
[Unit]
Description=Create the sill state filesystem image
DefaultDependencies=no
After=local-fs-pre.target
Before=var-lib-sill.mount
ConditionPathExists=!/var/lib/sill.img

[Service]
Type=oneshot
Environment=SILL_STATE_SIZE=32G
ExecStart=/usr/bin/truncate -s ${SILL_STATE_SIZE} /var/lib/sill.img
ExecStart=/usr/sbin/mkfs.ext4 -q -L sill-state -m 0 -E lazy_itable_init=1,lazy_journal_init=1 /var/lib/sill.img
ExecStart=/usr/bin/chmod 600 /var/lib/sill.img

[Install]
WantedBy=var-lib-sill.mount
