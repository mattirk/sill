# Mounts the sill state image at /var/lib/sill (SPEC §4.9). Replace with a real partition by changing
# What=/Options= (drop "loop"). The directory is sticky and world-writable like /tmp: each user creates
# /var/lib/sill/<uid> (0700) for their own sessions.
[Unit]
Description=sill state filesystem
Requires=sill-state-setup.service
After=sill-state-setup.service

[Mount]
What=/var/lib/sill.img
Where=/var/lib/sill
Type=ext4
Options=loop,noatime,nosuid,nodev

[Install]
WantedBy=local-fs.target
