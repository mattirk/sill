# Mounts the silli state image at /var/lib/silli (SPEC §4.9). Replace with a real partition by changing
# What=/Options= (drop "loop"). The directory is sticky and world-writable like /tmp: each user creates
# /var/lib/silli/<uid> (0700) for their own sessions.
[Unit]
Description=silli state filesystem
Requires=silli-state-setup.service
After=silli-state-setup.service

[Mount]
What=/var/lib/silli.img
Where=/var/lib/silli
Type=ext4
Options=loop,noatime,nosuid,nodev

[Install]
WantedBy=local-fs.target
