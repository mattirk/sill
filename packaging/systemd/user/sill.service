# The sill daemon (docs/daemon.md): sessions, ledger, memory behind $XDG_RUNTIME_DIR/sill/daemon.sock.
# Started by sill.socket on the first connection; always on from then (decision 4).
#   systemctl --user status sill          # is it up
#   journalctl --user -u sill -f          # its log
#   systemctl --user restart sill         # after an update — sessions survive it: each is a scope
#                                         # sill-<id>.scope under sill.slice, not part of this unit
#   systemctl --user set-property sill.slice MemoryMax=16G   # cap every session together
#   systemctl --user reset-failed sill.socket sill.service && systemctl --user start sill.socket
#                                         # after ten failed starts in a minute (the start limit):
#                                         # the socket stopped with the service, the journal has why
[Unit]
Description=sill daemon
Requires=sill.socket
After=sill.socket
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
# READY=1 once it listens, WATCHDOG=1 every 15 s while every lock of the hub answers
# (docs/daemon.md §3.7): a daemon that finds a lock stuck leaves by itself (status 102), one too
# wedged to say so is killed here; either way sessions keep running and the next daemon adopts them
Type=notify
NotifyAccess=main
WatchdogSec=90
ExecStart=/usr/local/bin/sill daemon
# a stop is asked over the socket (the reply, STOPPING=1, the pid file removed, exit 0) rather
# than signalled; SIGTERM follows only for a daemon that does not answer
ExecStop=/usr/local/bin/sill daemon stop
Restart=on-failure
RestartSec=2
Slice=app.slice
