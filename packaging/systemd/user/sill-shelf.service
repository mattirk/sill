# The sill shelf as a systemd user service: starts hidden with the graphical session, Alt+Space shows it.
#   systemctl --user restart sill-shelf     # after an update
#   journalctl --user -u sill-shelf -f      # its log
# Installed to /etc/systemd/user/ by the package / install.sh; enable per user with
#   systemctl --user enable --now sill-shelf
# Cinnamon does not activate graphical-session.target, so the service hangs off default.target; the
# user instance already carries DISPLAY/XAUTHORITY/DBUS_SESSION_BUS_ADDRESS on this desktop.
[Unit]
Description=sill agent shelf

[Service]
Type=simple
ExecStart=/usr/local/bin/sill shelf --hidden
Restart=on-failure
RestartSec=2
Slice=app.slice

[Install]
WantedBy=default.target
