# sill-gui as a systemd user service: starts hidden with the graphical session, the hotkey shows it.
#   systemctl --user restart sill-gui     # after an update (`sill restart` does this and the daemon)
#   journalctl --user -u sill-gui -f      # its log
# Installed to /etc/systemd/user/ by the package / `sill init`; enabled per user by `sill init --user`
#   (systemctl --user enable --now sill-gui)
# Cinnamon does not activate graphical-session.target, so the service hangs off default.target; the
# user instance already carries DISPLAY/XAUTHORITY/DBUS_SESSION_BUS_ADDRESS on this desktop.
[Unit]
Description=sill desktop window

[Service]
Type=simple
ExecStart=/usr/local/bin/sill gui --hidden
Restart=on-failure
RestartSec=2
Slice=app.slice

[Install]
WantedBy=default.target
